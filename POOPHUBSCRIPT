-- [ 7. Ground Hakai (地面破壊) Physics Render Pipeline ]
-- ================================================================================
poophub.GroundHakai = {
    IntensityLevel = 1.0,
    TotalDestructions = 0,
    DestructionLog = {}
}

function poophub.GroundHakai:SetIntensity(level)
    self.IntensityLevel = poophub.Utils.Clamp(level, 0.1, 10.0)
    poophub.Logger:Info(string.format("[GroundHakai] Intensity scaled to %.2f", self.IntensityLevel))
    poophub.Events.Dispatch("GroundHakai_IntensityChanged", self.IntensityLevel)
end

function poophub.GroundHakai:ExecuteBreak(originVector)
    local cfg = poophub.Config.GroundHakaiModule
    local power = cfg.PowerScale * self.IntensityLevel
    
    poophub.Logger:Info(string.format(
        "[GroundHakai] Executing destruction sequence at origin [%.1f, %.1f, %.1f] with power: %.0f", 
        originVector.X, originVector.Y, originVector.Z, power))
        
    local detected = poophub.AnitGrab:ScanArea(originVector, cfg.ImpactRadius)
    local affected = 0
    
    for idx, obj in ipairs(detected) do
        local impulse = {
            X = poophub.Utils.RandomRange(-50, 50) * self.IntensityLevel,
            Y = -power,
            Z = poophub.Utils.RandomRange(-50, 50) * self.IntensityLevel
        }
        
        poophub.DCUS:PushPacket("GROUND_BREAK_PHYSICS", {
            ObjectID = obj.ID,
            CalculatedImpulse = impulse,
            OriginVector = originVector,
            SequenceIndex = idx,
            RemoteConfigSource = obj.Source == "remote" and obj.Endpoint or nil
        })
        
        affected = affected + 1
    end
    
    self.TotalDestructions = self.TotalDestructions + 1
    
    table.insert(self.DestructionLog, {
        Origin = originVector,
        AffectedCount = affected,
        Power = power,
        Time = os.clock()
    })
    
    if #self.DestructionLog > 100 then
        table.remove(self.DestructionLog, 1)
    end
    
    poophub.Events.Dispatch("GroundHakai_Executed", {
        Origin = originVector,
        AffectedCount = affected,
        PowerApplied = power
    })
    
    return affected
end

function poophub.GroundHakai:GetStatistics()
    return {
        Intensity = self.IntensityLevel,
        TotalDestructions = self.TotalDestructions,
        LogSize = #self.DestructionLog
    }
end

