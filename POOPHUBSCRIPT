-- [ 6. AnitGrab Engine Module ]
-- ================================================================================
poophub.AnitGrab = {
    ActiveState = false,
    TargetsProcessed = 0,
    LastScanResults = {},
    ScanHistory = {}
}

function poophub.AnitGrab:Toggle(state)
    self.ActiveState = (state ~= nil) and state or not self.ActiveState
    poophub.Events.Dispatch("AnitGrab_StateChanged", self.ActiveState)
    poophub.Logger:Info(string.format("[AnitGrab] Status updated: %s", tostring(self.ActiveState)))
end

function poophub.AnitGrab:ScanArea(centerPosition, radius)
    if not self.ActiveState then return {} end
    
    local cfg = poophub.Config.AnitGrabModule
    local mockDetectedObjects = {}
    local stepCount = math.min(8, cfg.MaxTargetsPerScan)
    
    for i = 1, stepCount do
        local angle = (i / stepCount) * math.pi * 2
        local offsetX = math.cos(angle) * radius
        local offsetZ = math.sin(angle) * radius
        
        table.insert(mockDetectedObjects, {
            ID = poophub.Utils.GenerateUUID(),
            Offset = {X = offsetX, Y = 0, Z = offsetZ},
            Distance = radius,
            Priority = cfg.PriorityMode == "Distance" and radius or math.random(1, 100),
            Source = "local"
        })
    end
    
    if cfg.IncludeRemoteTargets and poophub.RemoteConfig.Loaded then
        table.insert(mockDetectedObjects, {
            ID = "remote_" .. poophub.Utils.GenerateShortID(6),
            Offset = {X = radius * 2, Y = 0, Z = 0},
            Distance = radius * 2,
            Priority = 1,
            Source = "remote",
            Endpoint = poophub.RemoteConfig.Endpoint
        })
    end
    
    table.sort(mockDetectedObjects, function(a, b)
        return a.Priority < b.Priority
    end)
    
    self.TargetsProcessed = self.TargetsProcessed + #mockDetectedObjects
    self.LastScanResults = mockDetectedObjects
    
    table.insert(self.ScanHistory, {
        Center = centerPosition,
        Radius = radius,
        Count = #mockDetectedObjects,
        Time = os.clock()
    })
    
    if #self.ScanHistory > 50 then
        table.remove(self.ScanHistory, 1)
    end
    
    return mockDetectedObjects
end

function poophub.AnitGrab:GetStatistics()
    return {
        Active = self.ActiveState,
        TotalTargetsProcessed = self.TargetsProcessed,
        LastScanCount = #self.LastScanResults,
        ScansPerformed = #self.ScanHistory
    }
end

