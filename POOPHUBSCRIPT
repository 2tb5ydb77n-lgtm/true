poophub.Utils = {}

function poophub.Utils.Clamp(val, min, max)
    if val < min then return min end
    if val > max then return max end
    return val
end

function poophub.Utils.Lerp(a, b, t)
    return a + (b - a) * poophub.Utils.Clamp(t, 0, 1)
end

function poophub.Utils.SmoothStep(t)
    t = poophub.Utils.Clamp(t, 0, 1)
    return t * t * (3 - 2 * t)
end

function poophub.Utils.EaseInOut(t)
    t = poophub.Utils.Clamp(t, 0, 1)
    return t < 0.5 and 2 * t * t or -1 + (4 - 2 * t) * t
end

function poophub.Utils.GenerateUUID()
    local template ='xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'
    return string.gsub(template, '[xy]', function (c)
        local v = (c == 'x') and math.random(0, 0xf) or math.random(8, 0xb)
        return string.format('%x', v)
    end)
end

function poophub.Utils.GenerateShortID(length)
    length = length or 8
    local charset = "abcdefghijklmnopqrstuvwxyz0123456789"
    local result = {}
    for i = 1, length do
        local idx = math.random(1, #charset)
        table.insert(result, charset:sub(idx, idx))
    end
    return table.concat(result)
end

function poophub.Utils.ColorToHex(color)
    local r = math.floor(color.R * 255)
    local g = math.floor(color.G * 255)
    local b = math.floor(color.B * 255)
    return string.format("#%02X%02X%02X", r, g, b)
end

function poophub.Utils.HexToColor(hex)
    hex = hex:gsub("#", "")
    return {
        R = tonumber(hex:sub(1,2), 16) / 255,
        G = tonumber(hex:sub(3,4), 16) / 255,
        B = tonumber(hex:sub(5,6), 16) / 255
    }
end

function poophub.Utils.Round(num, decimals)
    decimals = decimals or 0
    local mult = 10 ^ decimals
    return math.floor(num * mult + 0.5) / mult
end

function poophub.Utils.TableLength(tbl)
    local count = 0
    for _ in pairs(tbl) do count = count + 1 end
    return count
end

function poophub.Utils.DeepCopy(orig)
    local copy
    if type(orig) == 'table' then
        copy = {}
        for k, v in next, orig, nil do
            copy[poophub.Utils.DeepCopy(k)] = poophub.Utils.DeepCopy(v)
        end
        setmetatable(copy, poophub.Utils.DeepCopy(getmetatable(orig)))
    else
        copy = orig
    end
    return copy
end

function poophub.Utils.TableMerge(dest, src)
    for k, v in pairs(src) do
        if type(v) == "table" and type(dest[k]) == "table" then
            poophub.Utils.TableMerge(dest[k], v)
        else
            dest[k] = v
        end
    end
    return dest
end

function poophub.Utils.FormatBytes(bytes)
    local units = {"B", "KB", "MB", "GB", "TB"}
    local i = 1
    while bytes >= 1024 and i < #units do
        bytes = bytes / 1024
        i = i + 1
    end
    return string.format("%.2f %s", bytes, units[i])
end

function poophub.Utils.FormatTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

function poophub.Utils.VectorMagnitude(vec)
    return math.sqrt(vec.X^2 + vec.Y^2 + vec.Z^2)
end

function poophub.Utils.VectorNormalize(vec)
    local mag = poophub.Utils.VectorMagnitude(vec)
    if mag == 0 then return {X = 0, Y = 0, Z = 0} end
    return {X = vec.X / mag, Y = vec.Y / mag, Z = vec.Z / mag}
end

function poophub.Utils.VectorAdd(a, b)
    return {X = a.X + b.X, Y = a.Y + b.Y, Z = a.Z + b.Z}
end

function poophub.Utils.VectorSubtract(a, b)
    return {X = a.X - b.X, Y = a.Y - b.Y, Z = a.Z - b.Z}
end

function poophub.Utils.VectorDot(a, b)
    return a.X * b.X + a.Y * b.Y + a.Z * b.Z
end

function poophub.Utils.VectorCross(a, b)
    return {
        X = a.Y * b.Z - a.Z * b.Y,
        Y = a.Z * b.X - a.X * b.Z,
        Z = a.X * b.Y - a.Y * b.X
    }
end

function poophub.Utils.VectorScale(v, scalar)
    return {X = v.X * scalar, Y = v.Y * scalar, Z = v.Z * scalar}
end

function poophub.Utils.RandomRange(min, max)
    return min + math.random() * (max - min)
end

function poophub.Utils.RandomInt(min, max)
    return math.random(min, max)
end

function poophub.Utils.RandomChoice(tbl)
    return tbl[math.random(1, #tbl)]
end

function poophub.Utils.Shuffle(tbl)
    for i = #tbl, 2, -1 do
        local j = math.random(i)
        tbl[i], tbl[j] = tbl[j], tbl[i]
    end
    return tbl
end

function poophub.Utils.Trim(str)
    return (str:gsub("^%s*(.-)%s*$", "%1"))
end

function poophub.Utils.Split(str, delimiter)
    local result = {}
    for token in string.gmatch(str, "([^" .. delimiter .. "]+)") do
        table.insert(result, token)
    end
    return result
end

