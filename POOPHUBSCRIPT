poophub.Logger = {
    _levels = {DEBUG = 1, INFO = 2, WARN = 3, ERROR = 4},
    _buffer = {},
    _maxBuffer = 500
}

function poophub.Logger:Log(level, message, context)
    local cfg = poophub.Config.Core
    local levelValue = self._levels[level] or 2
    local configLevel = self._levels[cfg.LogLevel] or 2
    
    if levelValue < configLevel then return end
    
    local entry = {
        Level = level,
        Message = message,
        Context = context,
        Timestamp = os.clock(),
        Thread = "main"
    }
    
    table.insert(self._buffer, entry)
    if #self._buffer > self._maxBuffer then
        table.remove(self._buffer, 1)
    end
    
    if cfg.VerboseLogging then
        print(string.format("[%s] %s", level, message))
    end
    
    poophub.Events.Dispatch("Log_Entry", entry)
end

function poophub.Logger:Debug(msg, ctx) self:Log("DEBUG", msg, ctx) end
function poophub.Logger:Info(msg, ctx) self:Log("INFO", msg, ctx) end
function poophub.Logger:Warn(msg, ctx) self:Log("WARN", msg, ctx) end
function poophub.Logger:Error(msg, ctx) self:Log("ERROR", msg, ctx) end

function poophub.Logger:GetBuffer()
    return poophub.Utils.DeepCopy(self._buffer)
end

function poophub.Logger:Clear()
    self._buffer = {}
end

-- ================================================================================
-- [ 5. DCUS Network & Security Subsystem ]
-- ================================================================================
poophub.DCUS = {
    SessionToken = nil,
    IsConnected = false,
    Queue = {},
    Stats = {
        PacketsSent = 0,
        PacketsReceived = 0,
        PacketsDropped = 0,
        BytesTransferred = 0,
        LastFlush = 0,
        RemoteEndpoint = poophub.RemoteConfig.Endpoint
    }
}

function poophub.DCUS:Initialize()
    self.SessionToken = poophub.Utils.GenerateUUID()
    self.IsConnected = true
    self.Stats.PacketsSent = 0
    self.Stats.PacketsReceived = 0
    self.Stats.PacketsDropped = 0
    self.Stats.BytesTransferred = 0
    poophub.Events.Dispatch("DCUS_Init", self.SessionToken)
    poophub.Logger:Info(string.format("[DCUS] Protocol initialized with Session ID: %s", self.SessionToken))
end

function poophub.DCUS:Disconnect()
    if not self.IsConnected then return end
    self:FlushBuffer()
    self.IsConnected = false
    poophub.Logger:Info("[DCUS] Session terminated")
    poophub.Events.Dispatch("DCUS_Disconnected", self.SessionToken)
end

function poophub.DCUS:PushPacket(packetType, payload)
    if not self.IsConnected then return false end
    
    local packet = {
        Header = {
            Type = packetType,
            Timestamp = os.clock(),
            Token = self.SessionToken,
            Sequence = self.Stats.PacketsSent + 1,
            Checksum = poophub.Utils.GenerateShortID(12),
            RemoteSource = poophub.Config.Core.RemoteConfigEndpoint
        },
        Data = payload
    }
    
    table.insert(self.Queue, packet)
    if #self.Queue > poophub.Config.Core.MaxBufferCapacity then
        table.remove(self.Queue, 1)
        self.Stats.PacketsDropped = self.Stats.PacketsDropped + 1
    end
    
    self.Stats.PacketsSent = self.Stats.PacketsSent + 1
    poophub.Events.Dispatch("DCUS_PacketQueued", packet)
    return true
end

function poophub.DCUS:FlushBuffer()
    local processedCount = #self.Queue
    for _, packet in ipairs(self.Queue) do
        self.Stats.BytesTransferred = self.Stats.BytesTransferred + #tostring(packet.Data)
    end
    self.Queue = {}
    self.Stats.LastFlush = os.clock()
    return processedCount
end

function poophub.DCUS:GetStatistics()
    return poophub.Utils.DeepCopy(self.Stats)
end

function poophub.DCUS:ValidatePacket(packet)
    if not packet or not packet.Header then return false end
    if not packet.Header.Token or packet.Header.Token ~= self.SessionToken then
        return false
    end
    return true
end

