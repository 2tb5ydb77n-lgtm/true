-- [ 3. Event Dispatcher & State Management ]
-- ================================================================================
poophub.Events = {}
poophub.Events._listeners = {}
poophub.Events._history = {}
poophub.Events._historyLimit = 200

function poophub.Events.Subscribe(eventName, callback)
    if not poophub.Events._listeners[eventName] then
        poophub.Events._listeners[eventName] = {}
    end
    table.insert(poophub.Events._listeners[eventName], callback)
    return function()
        for i, cb in ipairs(poophub.Events._listeners[eventName]) do
            if cb == callback then
                table.remove(poophub.Events._listeners[eventName], i)
                break
            end
        end
    end
end

function poophub.Events.UnsubscribeAll(eventName)
    poophub.Events._listeners[eventName] = nil
end

function poophub.Events.Dispatch(eventName, ...)
    local listeners = poophub.Events._listeners[eventName]
    local args = {...}
    
    table.insert(poophub.Events._history, {
        Name = eventName,
        Args = args,
        Time = os.clock()
    })
    
    if #poophub.Events._history > poophub.Events._historyLimit then
        table.remove(poophub.Events._history, 1)
    end
    
    if listeners then
        for _, callback in ipairs(listeners) do
            pcall(callback, ...)
        end
    end
end

function poophub.Events.GetHistory(eventName)
    if not eventName then return poophub.Events._history end
    local filtered = {}
    for _, entry in ipairs(poophub.Events._history) do
        if entry.Name == eventName then
            table.insert(filtered, entry)
        end
    end
    return filtered
end

