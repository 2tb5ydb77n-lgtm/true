poophub.Telemetry = {
    Samples = {},
    StartTime = nil
}

function poophub.Telemetry:Start()
    self.StartTime = os.clock()
    self.Samples = {}
    poophub.Logger:Info("[Telemetry] Subsystem started")
end

function poophub.Telemetry:Sample()
    if not self.StartTime then return end
    table.insert(self.Samples, {
        Time = os.clock() - self.StartTime,
        MemoryUsage = collectgarbage("count"),
        TargetCount = poophub.AnitGrab.TargetsProcessed,
        Destructions = poophub.GroundHakai.TotalDestructions,
        PacketsInQueue = #poophub.DCUS.Queue,
        RemoteConfigLoaded = poophub.RemoteConfig.Loaded and 1 or 0
    })
    if #self.Samples > poophub.Config.Telemetry.MaxSamples then
        table.remove(self.Samples, 1)
    end
end

function poophub.Telemetry:GetAverages()
    if #self.Samples == 0 then return nil end
    local sumMem, sumTargets, sumDest = 0, 0, 0
    for _, s in ipairs(self.Samples) do
        sumMem = sumMem + s.MemoryUsage
        sumTargets = sumTargets + s.TargetCount
        sumDest = sumDest + s.Destructions
    end
    local n = #self.Samples
    return {
        AvgMemory = sumMem / n,
        AvgTargets = sumTargets / n,
        AvgDestructions = sumDest / n
    }
end

poophub.Profiler = {
    Timers = {},
    Counters = {}
}

function poophub.Profiler:StartTimer(name)
    self.Timers[name] = self.Timers[name] or {Total = 0, Count = 0}
    self.Timers[name].Start = os.clock()
end

function poophub.Profiler:StopTimer(name)
    if not self.Timers[name] or not self.Timers[name].Start then return end
    local elapsed = os.clock() - self.Timers[name].Start
    self.Timers[name].Total = self.Timers[name].Total + elapsed
    self.Timers[name].Count = self.Timers[name].Count + 1
    self.Timers[name].Start = nil
end

function poophub.Profiler:IncrementCounter(name, amount)
    amount = amount or 1
    self.Counters[name] = (self.Counters[name] or 0) + amount
end

function poophub.Profiler:GetReport()
    local report = {Timers = {}, Counters = poophub.Utils.DeepCopy(self.Counters)}
    for name, data in pairs(self.Timers) do
        report.Timers[name] = {
            Total = data.Total,
            Count = data.Count,
            Average = data.Count > 0 and (data.Total / data.Count) or 0
        }
    end
    return report
end

-- ================================================================================
-- [ 10. Task Scheduler & Job Queue ]
-- ================================================================================
poophub.Scheduler = {
    Tasks = {},
    NextID = 1
}

function poophub.Scheduler:Schedule(interval, callback, options)
    options = options or {}
    local task = {
        ID = self.NextID,
        Interval = interval,
        Callback = callback,
        LastRun = 0,
        Repeating = options.Repeating ~= false,
        MaxRuns = options.MaxRuns or math.huge,
        RunCount = 0,
        Enabled = true,
        Name = options.Name or ("Task_" .. self.NextID)
    }
    self.NextID = self.NextID + 1
    table.insert(self.Tasks, task)
    poophub.Logger:Debug(string.format("[Scheduler] Scheduled task %s (%.2fs interval)", task.Name, interval))
    return task.ID
end

function poophub.Scheduler:Cancel(taskID)
    for i, task in ipairs(self.Tasks) do
        if task.ID == taskID then
            table.remove(self.Tasks, i)
            return true
        end
    end
    return false
end

function poophub.Scheduler:Update(currentTime)
    for i = #self.Tasks, 1, -1 do
        local task = self.Tasks[i]
        if task.Enabled and (currentTime - task.LastRun) >= task.Interval then
            task.LastRun = currentTime
            task.RunCount = task.RunCount + 1
            local ok, err = pcall(task.Callback, task)
            if not ok then
                poophub.Logger:Error(string.format("[Scheduler] Task %s failed: %s", task.Name, tostring(err)))
            end
            if not task.Repeating or task.RunCount >= task.MaxRuns then
                table.remove(self.Tasks, i)
            end
        end
    end
end

-- ================================================================================
-- [ 11. Memory Pool & Cache Manager ]
-- ================================================================================
poophub.Cache = {
    Store = {},
    Metadata = {},
    MaxEntries = 1000
}

function poophub.Cache:Set(key, value, ttl)
    self.Store[key] = value
    self.Metadata[key] = {
        Created = os.clock(),
        TTL = ttl or math.huge,
        AccessCount = 0
    }
    
    if poophub.Utils.TableLength(self.Store) > self.MaxEntries then
        self:EvictOldest()
    end
end

function poophub.Cache:Get(key)
    if not self.Store[key] then return nil end
    local meta = self.Metadata[key]
    if os.clock() - meta.Created > meta.TTL then
        self:Invalidate(key)
        return nil
    end
    meta.AccessCount = meta.AccessCount + 1
    return self.Store[key]
end

function poophub.Cache:Invalidate(key)
    self.Store[key] = nil
    self.Metadata[key] = nil
end

function poophub.Cache:EvictOldest()
    local oldestKey, oldestTime = nil, math.huge
    for key, meta in pairs(self.Metadata) do
        if meta.Created < oldestTime then
            oldestTime = meta.Created
            oldestKey = key
        end
    end
    if oldestKey then self:Invalidate(oldestKey) end
end

function poophub.Cache:Clear()
    self.Store = {}
    self.Metadata = {}
end

-- ================================================================================
-- [ 12. State Machine ]
-- ================================================================================
poophub.StateMachine = {}
poophub.StateMachine.__index = poophub.StateMachine

function poophub.StateMachine.new(initialState)
    local sm = setmetatable({}, poophub.StateMachine)
    sm.Current = initialState
    sm.States = {}
    sm.Transitions = {}
    sm.History = {}
    return sm
end

function poophub.StateMachine:AddState(name, onEnter, onExit)
    self.States[name] = {
        OnEnter = onEnter,
        OnExit = onExit
    }
end

function poophub.StateMachine:AddTransition(from, to, condition)
    self.Transitions[from] = self.Transitions[from] or {}
    table.insert(self.Transitions[from], {To = to, Condition = condition})
end

function poophub.StateMachine:TransitionTo(newState, ...)
    if not self.States[newState] then return false end
    local oldState = self.Current
    if self.States[oldState] and self.States[oldState].OnExit then
        self.States[oldState].OnExit(...)
    end
    table.insert(self.History, {From = oldState, To = newState, Time = os.clock()})
    self.Current = newState
    if self.States[newState].OnEnter then
        self.States[newState].OnEnter(...)
    end
    poophub.Events.Dispatch("StateMachine_Transitioned", oldState, newState)
    return true
end

-- ================================================================================
-- [ 13. Signal Bus (Pub/Sub with Filters) ]
-- ================================================================================
poophub.SignalBus = {
    Channels = {}
}

function poophub.SignalBus:CreateChannel(name)
    if not self.Channels[name] then
        self.Channels[name] = {Subscribers = {}, Filter = nil}
    end
    return name
end

function poophub.SignalBus:Subscribe(channelName, callback, filter)
    self:CreateChannel(channelName)
    table.insert(self.Channels[channelName].Subscribers, {
        Callback = callback,
        Filter = filter
    })
end

function poophub.SignalBus:Send(channelName, payload)
    local ch = self.Channels[channelName]
    if not ch then return end
    for _, sub in ipairs(ch.Subscribers) do
        if not sub.Filter or sub.Filter(payload) then
            pcall(sub.Callback, payload)
        end
    end
end

-- ================================================================================
-- [ 14. Command Registry ]
-- ================================================================================
poophub.Commands = {
    Registry = {}
}

function poophub.Commands:Register(name, handler, description)
    self.Registry[name] = {
        Handler = handler,
        Description = description or "",
        CallCount = 0
    }
end

function poophub.Commands:Execute(name, ...)
    local cmd = self.Registry[name]
    if not cmd then
        poophub.Logger:Warn(string.format("[Commands] Unknown command: %s", name))
        return false
    end
    cmd.CallCount = cmd.CallCount + 1
    local ok, err = pcall(cmd.Handler, ...)
    if not ok then
        poophub.Logger:Error(string.format("[Commands] Command '%s' failed: %s", name, tostring(err)))
    end
    return ok
end

function poophub.Commands:List()
    local list = {}
    for name, cmd in pairs(self.Registry) do
        table.insert(list, {Name = name, Description = cmd.Description, Calls = cmd.CallCount})
    end
    table.sort(list, function(a, b) return a.Name < b.Name end)
    return list
end

-- ================================================================================
-- [ 15. Data Serialization Helpers ]
-- ================================================================================
poophub.Serializer = {}

function poophub.Serializer.EncodeTable(tbl, indent)
    indent = indent or 0
    local spaces = string.rep("  ", indent)
    local result = "{\n"
    for k, v in pairs(tbl) do
        local key
        if type(k) == "string" then
            key = string.format('["%s"]', k)
        else
            key = "[" .. tostring(k) .. "]"
        end
        local value
        if type(v) == "table" then
            value = poophub.Serializer.EncodeTable(v, indent + 1)
        elseif type(v) == "string" then
            value = string.format('"%s"', v)
        else
            value = tostring(v)
        end
        result = result .. spaces .. "  " .. key .. " = " .. value .. ",\n"
    end
    return result .. spaces .. "}"
end

function poophub.Serializer.DecodeSimple(str)
    local env = {}
    local fn = loadstring or load
    local chunk = fn("return " .. str)
    if chunk then
        setfenv = setfenv or function(f, e) end
        setfenv(chunk, env)
        local ok, result = pcall(chunk)
        if ok then return result end
    end
    return nil
end

-- ================================================================================
-- [ 16. Watchdog & Health Monitor ]
-- ================================================================================
poophub.Watchdog = {
    LastHeartbeat = 0,
    Healthy = true,
    FailureCount = 0
}

function poophub.Watchdog:Heartbeat()
    self.LastHeartbeat = os.clock()
end

function poophub.Watchdog:Check()
    local elapsed = os.clock() - self.LastHeartbeat
    if elapsed > poophub.Config.Core.WatchdogTimeout then
        self.Healthy = false
        self.FailureCount = self.FailureCount + 1
        poophub.Logger:Warn(string.format("[Watchdog] Timeout detected (%.2fs since last heartbeat)", elapsed))
        poophub.Events.Dispatch("Watchdog_Timeout", elapsed)
    else
        self.Healthy = true
    end
    return self.Healthy
end

-- ================================================================================
-- [ 17. Remote Config Manager (リンク統合モジュール) ]
-- ================================================================================
poophub.RemoteManager = {
    LastSync = 0,
    SyncInterval = 30.0,
    SyncCount = 0,
    Errors = 0
}

function poophub.RemoteManager:Sync()
    local ok, err = pcall(function()
        poophub.RemoteConfig:Load()
    end)
    
    if ok then
        self.LastSync = os.clock()
        self.SyncCount = self.SyncCount + 1
        poophub.Logger:Info(string.format("[RemoteManager] Sync #%d complete", self.SyncCount))
        poophub.Events.Dispatch("RemoteManager_SyncComplete", self.SyncCount)
    else
        self.Errors = self.Errors + 1
        poophub.Logger:Error(string.format("[RemoteManager] Sync failed: %s", tostring(err)))
        poophub.Events.Dispatch("RemoteManager_SyncError", err)
    end
end

function poophub.RemoteManager:GetStatus()
    return {
        Endpoint = poophub.RemoteConfig.Endpoint,
        Loaded = poophub.RemoteConfig.Loaded,
        LastSync = self.LastSync,
        SyncCount = self.SyncCount,
        Errors = self.Errors
    }
end

function poophub.RemoteManager:PrintStatus()
    local st = self:GetStatus()
    print("==================================================")
    print("Remote Config Status:")
    print("  Endpoint:", st.Endpoint)
    print("  Loaded:", tostring(st.Loaded))
    print("  Sync Count:", st.SyncCount)
    print("  Errors:", st.Errors)
    print("==================================================")
end

-- ================================================================================
-- [ 18. Core Initialization & Main Loop Lifecycle ]
-- ================================================================================
function poophub:Init()
    print("--------------------------------------------------")
    print(string.format("Booting %s Framework", self._VERSION))
    print(string.format("Build: %s | Environment: %s", self._BUILD, self._ENV))
    print("--------------------------------------------------")
    
    -- Remote Config Banner
    if self.Config.Core.RemoteConfigEnabled then
        self.RemoteConfig:PrintBanner()
        self.RemoteConfig:Load()
    end
    
    -- Subsystem Startup
    poophub.Logger:Info("[Core] Starting subsystem initialization sequence...")
    poophub.DCUS:Initialize()
    poophub.AnitGrab:Toggle(poophub.Config.AnitGrabModule.Enabled)
    poophub.Telemetry:Start()
    poophub.Watchdog:Heartbeat()
    poophub.RemoteManager:Sync()
    
    -- Register default commands
    poophub.Commands:Register("status", function()
        print("Framework Status:")
        print("  DCUS Connected:", poophub.DCUS.IsConnected)
        print("  AnitGrab Active:", poophub.AnitGrab.ActiveState)
        print("  UI Windows:", poophub.UI:GetWindowCount())
        print("  Scheduler Tasks:", #poophub.Scheduler.Tasks)
        print("  Remote Loaded:", poophub.RemoteConfig.Loaded)
        print("  Remote Endpoint:", poophub.RemoteConfig.Endpoint)
    end, "Displays current framework status")
    
    poophub.Commands:Register("flush", function()
        local count = poophub.DCUS:FlushBuffer()
        print(string.format("Flushed %d packets", count))
    end, "Flushes the DCUS buffer")
    
    poophub.Commands:Register("profile", function()
        local report = poophub.Profiler:GetReport()
        print("Profiler Report:")
        for name, data in pairs(report.Timers) do
            print(string.format("  %s: avg %.4fms over %d calls", name, data.Average * 1000, data.Count))
        end
    end, "Prints profiler report")
    
    poophub.Commands:Register("remote", function()
        poophub.RemoteManager:PrintStatus()
    end, "Shows remote config status")
    
    poophub.Commands:Register("banner", function()
        poophub.RemoteConfig:PrintBanner()
    end, "Prints the remote ASCII banner")
    
    -- Event Bindings
    poophub.Events.Subscribe("GroundHakai_Executed", function(data)
        print(string.format("[Event Log] 地面破壊完了: 影響オブジェクト数 %d 個", data.AffectedCount))
    end)
    
    poophub.Events.Subscribe("AnitGrab_StateChanged", function(state)
        poophub.Logger:Debug(string.format("[Event Log] AnitGrab state -> %s", tostring(state)))
    end)
    
    poophub.Events.Subscribe("RemoteConfig_Loaded", function(payload)
        poophub.Logger:Info(string.format("[Event Log] Remote config loaded from %s", payload.Source))
    end)
    
    -- Schedule periodic tasks
    poophub.Scheduler:Schedule(1.0, function()
        poophub.Telemetry:Sample()
        poophub.Watchdog:Heartbeat()
    end, {Name = "TelemetrySampler"})
    
    poophub.Scheduler:Schedule(30.0, function()
        poophub.RemoteManager:Sync()
    end, {Name = "RemoteSync"})
    
    -- Construct Interface Layout
    local MainWindow = poophub.UI:CreateWindow("poophub Control Panel", 480, 420)
    
    MainWindow:AddLabel("=== poophub Control Center ===")
    MainWindow:AddRemoteBanner()
    
    MainWindow:AddButton("AnitGrab 切替", function()
        poophub.AnitGrab:Toggle()
    end)
    
    MainWindow:AddSlider("地面破壊 威力調整", 1, 10, 1, function(val)
        poophub.GroundHakai:SetIntensity(val)
    end)
    
    MainWindow:AddButton("地面破壊 実行 (テスト)", function()
        poophub.GroundHakai:ExecuteBreak({X = 0, Y = 0, Z = 0})
    end)
    
    MainWindow:AddToggle("Telemetry 有効化", true, function(val)
        poophub.Config.Telemetry.Enabled = val
    end)
    
    MainWindow:AddButton("ステータス表示", function()
        poophub.Commands:Execute("status")
    end)
    
    MainWindow:AddButton("Remote ステータス", function()
        poophub.RemoteManager:PrintStatus()
    end)
    
    MainWindow:AddButton("Remote バナー再表示", function()
        poophub.RemoteConfig:PrintBanner()
    end)
    
    MainWindow:AddInput("コマンド入力", "コマンドを入力...", function(value)
        poophub.Commands:Execute(value)
    end)
    
    print("[poophub] All modules successfully loaded and bound.")
    print(string.format("[poophub] Registered %d commands, %d scheduler tasks, %d UI windows.",
        poophub.Utils.TableLength(poophub.Commands.Registry),
        #poophub.Scheduler.Tasks,
        poophub.UI:GetWindowCount()))
    print(string.format("[poophub] Remote endpoint: %s", poophub.RemoteConfig.Endpoint))
end

-- ================================================================================
-- [ 19. Runtime Hook & Shutdown ]
-- ================================================================================
function poophub:Shutdown()
    poophub.Logger:Info("[Core] Shutdown initiated...")
    poophub.DCUS:Disconnect()
    poophub.Telemetry:Sample()
    poophub.Cache:Clear()
    poophub.Events.Dispatch("Core_Shutdown")
    poophub.Logger:Info("[Core] Shutdown complete.")
end

function poophub:GetVersion()
    return string.format("%s (build %s)", self._VERSION, self._BUILD)
end

function poophub:GetModuleSummary()
    return {
        Version = self._VERSION,
        Build = self._BUILD,
        Environment = self._ENV,
        RemoteEndpoint = self.RemoteConfig.Endpoint,
        Modules = {
            "RemoteConfig", "Config", "Utils", "Events", "Logger", "DCUS",
            "AnitGrab", "GroundHakai", "UI", "Telemetry",
            "Profiler", "Scheduler", "Cache", "StateMachine",
            "SignalBus", "Commands", "Serializer", "Watchdog", "RemoteManager"
        }
    }
end

